# Copy to .env and adjust. Every variable is prefixed SEAMLY_.
SEAMLY_DATABASE_URL=postgresql+asyncpg://seamly:seamly@localhost:5433/seamly
SEAMLY_SESSION_SECRET=change-me-in-env
SEAMLY_FIXTURE_DIR=data/fixtures/generic
# Auto-seed an empty ledger at boot (demo convenience). Set to 0 to disable.
SEAMLY_AUTO_SEED=1

# Analyst (Phase 3): any OpenAI-compatible endpoint. Leave empty to disable.
SEAMLY_LLM_BASE_URL=
SEAMLY_LLM_API_KEY=
SEAMLY_LLM_MODEL=
